# W5D Builder — Environment Configuration
# Copy this file to .env and fill in your API keys

# ─── LLM for Script Generation ───────────────────────────────────────────────
# Supported: openai, anthropic, gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ─── Image Generation ─────────────────────────────────────────────────────────
# Supported: dalle3, gemini, replicate, grok, mock
IMAGE_GEN_PROVIDER=mock

REPLICATE_API_KEY=r8_...
XAI_API_KEY=xai-...

# ─── TTS Voice Generation ─────────────────────────────────────────────────────
# Supported: elevenlabs, openai, google, mock
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_BASE_PATH=./data

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
FRONTEND_DIST=../frontend/dist
DEBUG=true
